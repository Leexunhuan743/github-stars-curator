{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GitHub Stars Curator Classification Ledger",
  "oneOf": [
    {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment" }
    },
    {
      "type": "object",
      "required": ["assignments"],
      "properties": {
        "assignments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assignment" }
        }
      },
      "additionalProperties": true
    }
  ],
  "$defs": {
    "assignment": {
      "type": "object",
      "required": ["nameWithOwner", "finalLists"],
      "properties": {
        "nameWithOwner": {
          "type": "string",
          "pattern": "^[^/]+/[^/]+$"
        },
        "finalLists": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "readmePath": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "summary": { "type": ["string", "null"] },
        "productType": { "type": ["string", "null"] },
        "primaryFunction": { "type": ["string", "null"] },
        "facets": {
          "type": "array",
          "items": { "type": "string" }
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "signals": {
          "type": "array",
          "items": { "type": "string" }
        },
        "candidateLists": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": {
          "enum": ["high", "medium", "low", null]
        },
        "reason": { "type": ["string", "null"] },
        "classificationStatus": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
